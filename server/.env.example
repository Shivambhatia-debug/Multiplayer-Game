# Vercel -> Project -> Settings -> Environment Variables
# Create a free app at https://ably.com and copy an API key with publish/subscribe/presence rights.
ABLY_API_KEY=xxxxx.yyyyy:zzzzzzzz
# Comma-separated list of frontend origins allowed to call the API. Use * while testing.
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
# Optional: online leaderboards. Add a free Upstash Redis database (Vercel Marketplace or upstash.com)
# and copy its REST URL and token here. Without them the game shows this device's best runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
